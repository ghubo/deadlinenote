{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deadlinenote",
  "compatibility_date": "2026-04-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker/index.ts",
  "observability": {
    "enabled": true
  },
  // Custom domains configuration for production deployment
  "routes": [
    // Example:
    // {
    //   "pattern": "yourdomain.com",
    //   "custom_domain": true
    // }
  ],
  // Frontend static assets configuration
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // D1 SQLite Database binding
  // Replace YOUR_D1_DATABASE_ID with your actual D1 database ID after running:
  // `npx wrangler d1 create deadlinenote-db`
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deadlinenote-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "src/worker/db/migrations"
    }
  ],
  // R2 Object Storage bucket binding for OCR image uploads
  // Create bucket using: `npx wrangler r2 bucket create deadlinenote-ocr`
  "r2_buckets": [
    {
      "binding": "OCR_IMAGES",
      "bucket_name": "deadlinenote-ocr"
    }
  ]
}
